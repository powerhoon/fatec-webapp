{
  "name": "Newsletter Subscription",
  "nodes": [
    {"id": "1", "name": "Webhook", "type": "n8n-nodes-base.webhook", "parameters": {"path": "newsletter", "options": {}}, "position": [0, 300]},
    {"id": "2", "name": "Set", "type": "n8n-nodes-base.set", "parameters": {"values": {"string": [{"name": "email", "value": "{{ $json.body.email }}"}, {"name": "name", "value": "{{ $json.body.name }}"}, {"name": "source", "value": "{{ $json.body.source }}"}]}}, "position": [250, 300]},
    {"id": "3", "name": "Email Validate", "type": "n8n-nodes-base.if", "parameters": {"conditions": {"string": [{"value1": "={{ $json.email }}", "operation": "isEmail"}]}}, "position": [500, 300]},
    {"id": "4", "name": "Supabase Insert", "type": "n8n-nodes-base.supabase", "parameters": {"tableId": "newsletter_subscribers", "operation": "create", "dataToSend": "defineBelow", "fieldsToSend": {"values": [{"fieldName": "email", "fieldValue": "={{ $json.email }}"}, {"fieldName": "name", "fieldValue": "={{ $json.name }}"}, {"fieldName": "source", "fieldValue": "={{ $json.source }}"}]}}, "position": [750, 200]},
    {"id": "5", "name": "Send Confirmation", "type": "n8n-nodes-base.emailSend", "parameters": {"fromEmail": "noreply@fatec.co.kr", "subject": "뉴스레터 구독 확인", "text": "감사합니다. 구독이 완료되었습니다."}, "position": [750, 450]},
    {"id": "6", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "parameters": {"respondWith": "json", "responseBody": "={\"success\":true,\"message\":\"Subscribed\"}"}, "position": [1000, 300]}
  ],
  "connections": {"1": {"main": [[{"node": "2", "index": 0}]]}, "2": {"main": [[{"node": "3", "index": 0}]]}, "3": {"main": [[{"node": "4", "index": 0}], [{"node": "5", "index": 0}]]}, "4": {"main": [[{"node": "6", "index": 0}]]}, "5": {"main": [[{"node": "6", "index": 0}]]}}
}